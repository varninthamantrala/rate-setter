    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
